%% ENGG131_HW5
% Author: Audrey Day
% calculate the new stress matrix for a rotation about z, then x, then y.

%% clear workspace
clear;
clc;

%% parameters
o = [6 2 -1; 2 -5 3; -1 3 4];           % stress matrix

ox =  o(1,1);                           % normal stress
oy =  o(2,2);
oz =  o(3,3);

txy = o(1,2);                           % shear stress
txz = o(1,3);
tyz = o(2,3);

T = deg2rad(20);                        % theta
P = deg2rad(40);                        % phi
S = deg2rad(30);                         % psi

R1 = [cos(T) sin(T) 0; -sin(T) cos(T) 0; 0 0 1];    %rotation about z
R2 = [1 0 0; 0 cos(P) sin(P); 0 -sin(P) cos(P)];    %rotation about x'
R3 = [cos(S) 0 sin(S); 0 1 0; -sin(S) 0 cos(S)];    %rotation about y''
R = R3*(R2*R1);

xx = R(1,1);
xy = R(1,2);
xz = R(1,3);
yx = R(2,1);
yy = R(2,2);
yz = R(2,3);
zx = R(3,1);
zy = R(3,2);
zz = R(3,3);

            
%% calculations

oxp = ox*xx^2 + oy*xy^2 + oz*xz^2 + 2*txy*xx*xy + 2*tyz*xy*xz + 2*txz*xx*xz;
oyp = ox*yx^2 + oy*yy^2 + oz*yz^2 + 2*txy*yx*yy + 2*tyz*yy*yz + 2*txz*yx*yz;
ozp = ox*zx^2 + oy*zy^2 + oz*zz^2 + 2*txy*zx*zy + 2*tyz*zy*zz + 2*txz*zx*zz;
txyp = ox*xx*yx + oy*xy*yy + oz*xz*yz + txy*(xx*yy + xy*yx) + tyz*(xy*yz + xz*yy)...
    +txz*(xx*yz + xz*yx);
txzp = ox*xx*zx + oy*xy*zy + oz*xz*zz + txy*(xx*zy + xy*zx) + tyz*(xy*zz + xz*zy)...
    +txz*(xx*zz + xz*zx);
tyzp = ox*yx*zx + oy*yy*zy + oz*yz*zz + txy*(yx*zy + yy*zx) + tyz*(yy*zz + yz*zy)...
    +txz*(yx*zz + yz*zx);

op = [oxp txyp txzp; txyp oyp tyzp; txzp tyzp ozp];



%% display results
disp(['Stress matrix for ', num2str(rad2deg(T)), ...
    ' degrees about z, then ', num2str(rad2deg(P))...
    ,' degrees about x, then ', num2str(rad2deg(S)),...
    ' degrees about y:']) 
disp(' ')
disp(num2str(op))
disp(' ')
