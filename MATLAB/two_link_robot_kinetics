%%TwoLink Robot_Inverse_Kinetics_Simulink_Input.m
% solve the inverse kinetics for a two-kink robot in real time for simulink input

function out  = Two_Link_Robot(theta1, theta1_dot, theta1_ddot, beta, beta_dot, beta_ddot)

%% Parameters

m1 = 2;                     %link 1 mass
m2 = 1;                     %link 2 mass
L1 = 2;                     %link 1 length
L2 = 1;                     %link 2 length
g = 9.81;                   %gravitational constant
I1 = 0.667;                 %link 1 mass moment of inertia
I2 = 0.083;                 %link 2 mass moment of inertia
c1 = 0.005;                 %joint 1 viscous damping 
c2 = 0.005;                 %joint 2 viscous damping
mee = 0.1;                  %end effector mass
mm2 = 0.25;                 %motor 2 mass
Tf1 = 1.6;                  %Coulomb friction
Tf2 = 0;

%% Create Matrices

a = zeros(6);               %'answers' column
b = zeros(6,1);             %'formula' matrix

a(1,1) = 1;
a(1,3) = 1;

a(2,2) = 1;
a(2,4) = 1;

a(3,1) = (L1/2)*sin(theta1);
a(3,2) = -((L1/2)*cos(theta1));
a(3,3) = -((L1/2)*sin(theta1));
a(3,4) = ((L1/2)*cos(theta1));
a(3,5) = 1;
a(3,6) = -1;

a(4,3) = -1;

a(5,4) = -1;

a(6,3) = -(L2/2)*sin(beta);
a(6,4) = (L2/2)*cos(beta);
a(6,6) = 1;

b(1,1) = -(m1/2 + mm2)*L1*sin(theta1)*theta1_ddot -(m1/2 + mm2)*L1*cos(theta1)*theta1_dot^2;

b(2,1) = (m1/2+mm2)*L1*cos(theta1)*theta1_ddot + m1*g + mm2*g - (m1/2 + mm2)*L1*sin(theta1)...
    *theta1_dot^2;

b(3,1) = (I1 + (mm2*(L1^2/2)))*theta1_ddot + Tf1*sign(theta1_dot)+(c1*theta1_dot) - (c2*(beta_dot-theta1_dot)) ...
    + mm2*g*(L1/2)*cos(theta1);

b(4,1) = -(m2 + mee)*L1*sin(theta1)*theta1_ddot -(m2/2 + mee)*L2*sin(beta)*beta_ddot ...
    -(m2 + mee)*L1*cos(theta1)*theta1_dot^2 -(m2/2 + mee)*L2*cos(beta)*beta_dot^2;

b(5,1) = m2*g + mee*g -(m2 + mee)*L1*sin(theta1)*theta1_dot^2 - (m2/2 + mee)*L2*sin(beta)*beta_dot^2 ...
    + (m2+mee)*L1*cos(theta1)*theta1_ddot + (m2/2+mee)*L2*cos(beta)*beta_ddot;

b(6,1) = (mee*g*L2/2*cos(beta)) + (mee*(L2/2)*L1*cos(beta-theta1)*theta1_ddot) + ...
    (I2 + (mee*(L2^2/2)))*beta_ddot + mee*(L2/2)*L1*sin(beta-theta1)*theta1_dot^2 + c2*(beta_dot-theta1_dot) ...
    + Tf2*sign(beta_dot - theta1_dot);

% out(1) = O1x;
% out(2) = O1y;
% out(3) = O2x;
% out(4) = O2y;
% out(5) = tau1;
% out(6) = tau2;

out = a\b;
end
