%% Turboprop_Flight_Envelope.m
% Author: Audrey Day
%

%% clear workspace
clear;
clc;
close all

%% Aircraft D: parameters
W = 3000;
Cdo = 0.028;
k = 0.048;
S = 175;
hcr = 15000;
hpmax = 235;
CLmax = 1.8;
np = 0.83;
p = 0.00238;
ocr = 0.629;
o = [1 0.862 0.738 0.629 0.533 0.448 0.374 0.310 0.297 0.289];
h = [0 5 10 15 20 25 30 35 36 36.6]*1000;

            
%% calculations
Vs = zeros(1,10);
Vpmin = Vs;
V = zeros(4,10);

for i=1:3
Vs(i) = ((2*(W/S))/(p*o(i)*CLmax))^(1/2);
Vpmin(i) = ((2*(W/S))/(p*o(i)))^(1/2)*(k/(3*Cdo))^(1/4);

syms X

A = solve((Cdo*p*o(i)*X^3)/(2*(W/S)) + (2*k*(W/S))/(p*o(i)*X) - 550*np*(hpmax/W));
V(i,1) = A(1,1);
V(i,2) = A(2,1);

end

for i=4:10
Vs(i) = ((2*(W/S))/(p*o(i)*CLmax))^(1/2);
Vpmin(i) = ((2*(W/S))/(p*o(i)))^(1/2)*(k/(3*Cdo))^(1/4);

A = solve((Cdo*p*o(i)*X^3)/(2*(W/S)) + (2*k*(W/S))/(p*o(i)*X) - 550*np*(hpmax/W)*(o(i)/ocr));
V(i,1) = A(1,1);
V(i,2) = A(2,1);

end

V12 = V(1:10,1:2);

%% display results

plot(V12,h, Linewidth=2)
hold on
plot(Vs,h, Linewidth=2)
plot(Vpmin,h, Linewidth=2)
plot(V12(10,1), h(10), "k.", Markersize=20)
text(V12(10,1), h(10), "   Vc: 194.1 ft/s", fontsize=15)
legend("V2", "V1", "Vs", "Vpmin", fontsize=15)
ylabel("Altitude(ft)", fontsize=15)
xlabel("Velocity(ft/s)", fontsize=15)
title("Turboprop Flight Envelope", fontsize=25)
